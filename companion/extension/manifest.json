{
  "manifest_version": 3,
  "name": "kmdr Companion",
  "version": "0.1.0",
  "key": "",
  "description": "在 kxx.moe 页面直接提交下载到 kmdr CLI",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://kxx.moe/*",
    "https://mox.moe/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kxx.moe/c/*.htm*",
        "https://mox.moe/c/*.htm*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "kmdr Companion"
  }
}
